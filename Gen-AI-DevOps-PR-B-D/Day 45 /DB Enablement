 STEP 3: Seed Database with Sample Data
db/seed_data.py
import sqlite3
from pathlib import Path

DB_PATH = Path(__file__).parent.parent / "devops.db"

conn = sqlite3.connect(DB_PATH)
cursor = conn.cursor()

cursor.executescript(open("db/schema.sql").read())

services = [
    ("cloud_run_api", "prod", "DOWN", "2025-01-18"),
    ("payment_service", "prod", "UP", "2025-01-20"),
    ("ci_pipeline", "staging", "FAILED", "2025-01-19"),
]

cursor.executemany(
    "INSERT OR REPLACE INTO services VALUES (?, ?, ?, ?)",
    services
)

conn.commit()
conn.close()

print("✅ Database seeded successfully")


Run:

python3 db/seed_data.py

 STEP 4: Database Client Layer
db/db_client.py
import sqlite3
from pathlib import Path

DB_PATH = Path(__file__).parent.parent / "devops.db"

def get_connection():
    """
    Returns a SQLite connection to devops.db
    """
    return sqlite3.connect(DB_PATH)

 STEP 5: Tool Layer (DB Tool)
tools/db_tool.py
from db.db_client import get_connection

def fetch_service_status(service_name: str):
    conn = get_connection()
    cursor = conn.cursor()

    cursor.execute(
        """
        SELECT service_name, environment, status, last_deployed
        FROM services
        WHERE service_name = ?
        """,
        (service_name,)
    )

    row = cursor.fetchone()
    conn.close()

    if not row:
        return None

    return {
        "service_name": row[0],
        "environment": row[1],
        "status": row[2],
        "last_deployed": row[3],
    }

 STEP 6: Agent Logic (DB Agent)
agent/db_agent.py
from tools.db_tool import fetch_service_status

def answer(user_query: str) -> str:
    """
    DB Agent entry point.
    Handles service status queries using DB.
    """

    if "status" in user_query.lower():
        service_name = user_query.lower().replace("status", "").strip()

        if not service_name:
            return "❌ Please specify a service name (example: status cloud_run_api)"

        result = fetch_service_status(service_name)

        if not result:
            return f"❌ No service found with name: {service_name}"

        return (
            f"✅ Service: {result['service_name']}\n"
            f"Environment: {result['environment']}\n"
            f"Status: {result['status']}\n"
            f"Last Deployed: {result['last_deployed']}"
        )

    return "❓ I can answer queries like: status <service_name>"

