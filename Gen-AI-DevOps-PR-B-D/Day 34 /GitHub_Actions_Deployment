yaml
Copy code
name: Day34 CI/CD Cloud Run Deployment

on:
  push:
    branches:
      - main
  workflow_dispatch:

env:
  SERVICE_NAME: ai-demo-service
  REGION: us-central1

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Set up Google Cloud CLI
      uses: google-github-actions/setup-gcloud@v1
      with:
        project_id: ${{ secrets.GCP_PROJECT_ID }}
        service_account_key: ${{ secrets.GCP_SA_KEY }}
        export_default_credentials: true

    - name: Build container image
      run: |
        gcloud builds submit --tag gcr.io/${{ secrets.GCP_PROJECT_ID }}/day34-demo

    - name: Deploy to Cloud Run
      run: |
        gcloud run deploy $SERVICE_NAME \
          --image gcr.io/${{ secrets.GCP_PROJECT_ID }}/day34-demo \
          --region $REGION \
          --allow-unauthenticated

    - name: Slack Notification
      if: always()
      run: |
        message="Day34 Deployment Completed: ${{ job.status }}"
        curl -X POST -H 'Content-type: application/json' \
        --data "{\"text\":\"$message\"}" \
        ${{ secrets.SLACK_WEBHOOK_URL }}
