2.2 RAG Indexer

rag/indexer/index_rag.py

import os

DOCS_DIR = "rag/docs"

def load_docs():
    docs = []
    for root, _, files in os.walk(DOCS_DIR):
        for f in files:
            if f.endswith(".txt"):
                path = os.path.join(root, f)
                with open(path) as fh:
                    docs.append({
                        "source": path.replace("rag/", ""),
                        "text": fh.read()
                    })
    return docs

if __name__ == "__main__":
    docs = load_docs()
    print(f"Loaded {len(docs)} docs")

2.3 RAG Search

rag/search/search_rag.py

from rag.indexer.index_rag import load_docs

DOCS = load_docs()

def search_rag(query):
    return [d for d in DOCS if any(w in d["text"].lower() for w in query.lower().split())]

2.4 RAG Tool

tools/rag_tool.py

from rag.search.search_rag import search_rag

def devops_rag_search(query):
    results = search_rag(query)
    if not results:
        return "No relevant documentation found."
    return "\n\n".join(
        f"Source: {r['source']}\n{r['text']}" for r in results
    )

