3.3 DB Tool

tools/db_tool.py

from db.db_client import get_connection

def fetch_last_pipeline():
    conn = get_connection()
    cur = conn.cursor()
    cur.execute("""
      SELECT repo, branch, status, failure_reason, created_at
      FROM pipeline_history
      ORDER BY created_at DESC LIMIT 1
    """)
    row = cur.fetchone()
    return row

