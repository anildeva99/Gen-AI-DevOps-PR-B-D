 ai_debugger.py (AI-Powered GitHub Actions Log Analyzer)

  create ai_debugger.py

from flask import Flask, request, jsonify
import requests
import os
import re

app = Flask(__name__)

GITHUB_TOKEN = os.environ.get("GITHUB_TOKEN")
REPO = "adinarayanap/Gen-AI-DevOps"

# ----------- AI LOG ANALYZER -------------
def ai_analyze_logs(log_text):
    """
    A simple AI-like rules engine that reads logs,
    identifies the root cause, and gives a human explanation.
    """

    if "ERROR: Could not find a version that satisfies the requirement" in log_text:
        pkg = re.findall(r"ERROR: Could not find a version.*?requirement (.*)", log_text)
        return {
            "status": "Dependency installation failed",
            "root_cause": f"Package '{pkg[0]}' does not exist on PyPI.",
            "fix": "Use a valid package name or remove the invalid dependency."
        }

    if "ModuleNotFoundError" in log_text:
        module = re.findall(r"ModuleNotFoundError: No module named '(.*)'", log_text)
        return {
            "status": "Python module missing",
            "root_cause": f"The module '{module[0]}' is not installed.",
            "fix": "Add the module to requirements.txt or install it before running."
        }

    if "Permission denied" in log_text:
        return {
            "status": "Permission issue",
            "root_cause": "Your workflow attempted an operation without correct permissions.",
            "fix": "Check GitHub Actions permissions and secrets."
        }

    return {
        "status": "No major errors found",
        "root_cause": "No known patterns identified.",
        "fix": "Check logs manually for more details."
    }


# ----------- FETCH GITHUB ACTION RUN LOGS -------------
def fetch_logs(run_id):
    url = f"https://api.github.com/repos/{REPO}/actions/runs/{run_id}/logs"
    headers = {"Authorization": f"token {GITHUB_TOKEN}"}

    r = requests.get(url, headers=headers)
    if r.status_code != 200:
        return None, "Unable to fetch logs from GitHub"

    # Download zip
    with open("logs.zip", "wb") as f:
        f.write(r.content)

    import zipfile
    logs_text = ""

    with zipfile.ZipFile("logs.zip", "r") as z:
        for file in z.namelist():
            logs_text += z.read(file).decode(errors="ignore")

    return logs_text, None


@app.route("/debug", methods=["POST"])
def debug():
    data = request.json
    run_id = data.get("run_id")

    logs, error = fetch_logs(run_id)
    if error:
        return jsonify({"error": error}), 400

    result = ai_analyze_logs(logs)
    result["run_id"] = run_id
    return jsonify(result)


@app.route("/")
def home():
    return "AI Debugger Running on Cloud Run!"


if __name__ == "__main__":
    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", 8080)))


