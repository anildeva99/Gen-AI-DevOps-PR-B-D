name: Run PR Agent

on:
  pull_request:
    types: [opened, synchronize, reopened]
    branches:
      - main
      - dev

jobs:
  pr-agent:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: pip install -r Day50/pr_agent/requirements.txt

      - name: Debug env (safe)
        run: |
          echo "PR_NUMBER=${{ github.event.pull_request.number }}"
          echo "REPO=${{ github.repository }}"
          if [ -z "${{ secrets.PR_AGENT_GITHUB_TOKEN }}" ]; then
            echo "❌ Secret PR_AGENT_GITHUB_TOKEN is empty / not available"
          else
            echo "✅ Secret PR_AGENT_GITHUB_TOKEN is available"
          fi

      - name: Run PR Agent
        env:
          # IMPORTANT: set BOTH to avoid any mismatch in code/libs
          PR_AGENT_GITHUB_TOKEN: ${{ secrets.PR_AGENT_GITHUB_TOKEN }}
          GITHUB_TOKEN: ${{ secrets.PR_AGENT_GITHUB_TOKEN }}

          PR_NUMBER: ${{ github.event.pull_request.number }}
          PR_AGENT_REPO: ${{ github.repository }}

          GOOGLE_API_KEY: ${{ secrets.GOOGLE_API_KEY }}
          SLACK_WEBHOOK_URL: ${{ secrets.SLACK_WEBHOOK_URL }}
        run: |
          python Day50/pr_agent/main.py
