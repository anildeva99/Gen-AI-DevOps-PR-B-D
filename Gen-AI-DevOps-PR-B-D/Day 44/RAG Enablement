 Step 5: RAG Search (Simple Keyword Retrieval)

📄 File: rag/search/search_rag.py

import os

DOCS_DIR = "rag/docs"

def search_rag(query: str):
    results = []
    for root, _, files in os.walk(DOCS_DIR):
        for file in files:
            if file.endswith(".txt"):
                path = os.path.join(root, file)
                with open(path, "r") as f:
                    text = f.read()
                    if any(word.lower() in text.lower() for word in query.split()):
                        results.append({
                            "source": path.replace("rag/", ""),
                            "text": text.strip()
                        })
    return results

 Step 6: RAG Tool (Agent-Callable Tool)

📄 File: tools/rag_tool.py

from rag.search.search_rag import search_rag

def devops_rag_search(query: str) -> str:
    results = search_rag(query)
    if not results:
        return "No relevant documentation found in RAG."

    return "\n\n".join(
        f"Source: {r['source']}\n{r['text']}"
        for r in results
    )

 Step 7: Chat Application (Agent-Style Reasoning)

📄 File: app/chat.py

from tools.rag_tool import devops_rag_search

SYSTEM_PROMPT = """
You are a Senior DevOps Engineer AI Agent.
Answer ONLY using the provided documentation.
If no documentation is found, say you don't know.
Be concise and practical.
"""

print("🤖 DevOps ADK RAG Agent (type 'exit' to quit)\n")

while True:
    query = input("You: ").strip()
    if query.lower() in ("exit", "quit"):
        break

    rag_context = devops_rag_search(query)

    if "No relevant documentation" in rag_context:
        print("\nAgent: I don’t have relevant documentation for this.\n")
        continue

    final_prompt = f"""
{SYSTEM_PROMPT}

Documentation:
{rag_context}

Question:
{query}

Answer:
"""

    # Deterministic response for demo
    print("\nAgent:")
    print(rag_context)
    print()

