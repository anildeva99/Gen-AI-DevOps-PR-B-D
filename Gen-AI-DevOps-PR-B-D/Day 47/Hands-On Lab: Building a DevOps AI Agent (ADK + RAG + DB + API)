3️ RAG Search
rag/search/search_rag.py
from rag.indexer.index_rag import load_documents

def search_rag(query):
    docs = load_documents()
    results = []
    for d in docs:
        if query.lower() in d["text"].lower():
            results.append(d)
    return results

4️ RAG Tool
tools/rag_tool.py
from rag.search.search_rag import search_rag

def devops_rag_search(query: str) -> str:
    results = search_rag(query)
    if not results:
        return "No relevant documentation found."

    return "\n\n".join(
        f"Source: {r['source']}\n{r['text']}"
        for r in results
    )

