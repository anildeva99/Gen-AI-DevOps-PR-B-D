8️  DB Tool
tools/db_tool.py
from db.db_client import get_connection

def fetch_pipeline_status(repo_name):
    conn = get_connection()
    cur = conn.cursor()

    cur.execute(
        "SELECT status, timestamp FROM pipeline_history WHERE repo_name=? ORDER BY id DESC LIMIT 1",
        (repo_name,)
    )

    row = cur.fetchone()
    conn.close()

    if not row:
        return None

    return {"status": row[0], "timestamp": row[1]}

