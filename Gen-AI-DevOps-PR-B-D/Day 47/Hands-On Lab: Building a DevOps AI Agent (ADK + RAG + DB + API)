 LAB-4: ADK-Style Agent (Orchestrator)
agent/devops_agent.py
from tools.rag_tool import devops_rag_search
from tools.db_tool import fetch_pipeline_status

def answer(query: str) -> str:
    if "why" in query.lower():
        return devops_rag_search(query)

    if "status" in query.lower():
        repo = query.lower().replace("status", "").strip()
        result = fetch_pipeline_status(repo)
        if not result:
            return "No pipeline history found."
        return f"Pipeline status: {result['status']} at {result['timestamp']}"

    return "I can help with pipeline status and failures."

