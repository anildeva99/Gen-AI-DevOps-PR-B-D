#!/bin/bash

MODEL="codellama:7b"

echo " Interactive Ollama Shell Script Generator"
echo "Type 'exit' to quit."
echo "-------------------------------------------"

while true; do
    read -p "Enter your prompt: " USER_PROMPT
    if [[ "$USER_PROMPT" == "exit" ]]; then
        echo "Exiting."
        break
    fi

    echo " Generating script with Ollama..."
    ollama run $MODEL "$USER_PROMPT" | tee output.sh

    chmod +x output.sh
    echo " Script saved as output.sh (executable)"
    echo "Run it with: ./output.sh"
    echo "-------------------------------------------"
done
